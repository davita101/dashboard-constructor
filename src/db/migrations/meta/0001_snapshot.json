  "views": {
    "public.project_stats": {
      "name": "project_stats",
      "schema": "public",
      "columns": {
        "project_id": {
          "name": "project_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "stages": {
          "name": "stages",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "members": {
          "name": "members",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "files": {
          "name": "files",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "tasks": {
          "name": "tasks",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "tasks_new": {
          "name": "tasks_new",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "tasks_in_work": {
          "name": "tasks_in_work",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "tasks_done": {
          "name": "tasks_done",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "tasks_failed": {
          "name": "tasks_failed",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "progress": {
          "name": "progress",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    select\n      p.id as project_id,\n      (select count(*) from project_stages s where s.project_id = p.id)::int as stages,\n      (select count(*) from project_members m where m.project_id = p.id)::int as members,\n      (select count(*) from files f where f.project_id = p.id)::int as files,\n      t.total as tasks,\n      t.new as tasks_new,\n      t.in_work as tasks_in_work,\n      t.done as tasks_done,\n      t.failed as tasks_failed,\n      case when t.total = 0 then 0 else round(100.0 * t.done / t.total)::int end as progress\n    from projects p\n    cross join lateral (\n      select\n        count(*)::int as total,\n        (count(*) filter (where status = 'new'))::int as new,\n        (count(*) filter (where status = 'in_work'))::int as in_work,\n        (count(*) filter (where status = 'done'))::int as done,\n        (count(*) filter (where status = 'failed'))::int as failed\n      from tasks where tasks.project_id = p.id\n    ) t\n  ",
      "materialized": false,
      "with": {
        "securityInvoker": true
      },
      "isExisting": false
    },
    "public.stage_stats": {
      "name": "stage_stats",
      "schema": "public",
      "columns": {
        "stage_id": {
          "name": "stage_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "tasks": {
