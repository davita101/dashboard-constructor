          "primaryKey": false,
          "notNull": true
        },
        "members": {
          "name": "members",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "files": {
          "name": "files",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    select\n      s.id as stage_id,\n      (select count(*) from tasks t where t.stage_id = s.id)::int as tasks,\n      (select count(distinct a.user_id) from task_assignees a join tasks t on t.id = a.task_id where t.stage_id = s.id)::int as members,\n      (select count(*) from files f where f.stage_id = s.id)::int as files\n    from project_stages s\n  ",
      "materialized": false,
      "with": {
        "securityInvoker": true
      },
      "isExisting": false
    }
  },
