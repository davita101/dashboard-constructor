{
  "$description": "Color Mode variables that the Figma REST export leaves without a $value: they are {color alias + opacity alias} composites. Read from the Commerce Constructor 7.7 file via the Plugin API. Every <group>-alpha-<N> is <base> at N% opacity unless listed in alphaExceptions.",
  "alphaBase": {
    "Primary": "default-primary-500",
    "Base": "default-gray-500",
    "Gray": "default-gray-500",
    "Warning": "default-amber-500",
    "Success": "default-green-500",
    "Danger": "default-red-500",
    "Info": "default-sky-500",
    "White": "default-white",
    "Black": "default-black",
    "Orange": "default-orange-500",
    "Purple": "default-purple-500",
    "Red": "default-red-500",
    "Yellow": "default-yellow-500",
    "Green": "default-green-500",
    "Sky": "default-sky-500",
    "Pink": "default-pink-500",
    "Amber": "default-amber-500",
    "Teal": "default-teal-500",
    "Blue": "default-blue-500",
    "Indigo": "default-indigo-500",
    "Violet": "default-violet-500",
    "Fuchsia": "default-fuchsia-500",
    "Rose": "default-rose-500",
    "Emerald": "default-emerald-500",
    "Cyan": "default-cyan-500",
    "Lime": "default-lime-500"
  },
  "alphaExceptions": {
    "purple-alpha-65": { "Light": 65, "Dark": 70 },
    "violet-alpha-0": { "Light": 5, "Dark": 5 }
  },
  "shadows": {
    "shadow-base": { "Light": ["gray-500", 10], "Dark": ["default-black", 20] },
    "shadow-primary": { "Light": ["default-primary-500", 20], "Dark": ["default-primary-500", 30] },
    "shadow-success": { "Light": ["default-green-500", 20], "Dark": ["default-green-500", 30] },
    "shadow-danger": { "Light": ["default-red-500", 20], "Dark": ["default-red-500", 30] },
    "shadow-warning": { "Light": ["default-amber-500", 20], "Dark": ["default-amber-500", 30] },
    "shadow-info": { "Light": ["default-sky-500", 20], "Dark": ["default-sky-500", 30] },
    "shadow-orange": { "Light": ["default-orange-500", 20], "Dark": ["default-orange-500", 30] },
    "shadow-purple": { "Light": ["default-purple-500", 20], "Dark": ["default-purple-500", 30] },
    "shadow-red": { "Light": ["default-red-500", 20], "Dark": ["default-red-500", 30] },
    "shadow-yellow": { "Light": ["default-yellow-500", 20], "Dark": ["default-yellow-500", 30] },
    "shadow-green": { "Light": ["default-green-500", 20], "Dark": ["default-green-500", 30] },
